{
  "name": "bible-reader",
  "description": "Bible Reader — read, search, bookmark, and study scripture.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mrmendoza-dev/bible-reader.git"
  },
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun run --bun vite",
    "build": "bun run --bun tsc && bun run --bun vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit",
    "test:unit": "node ./node_modules/vitest/vitest.mjs run",
    "preview": "bun run --bun vite preview",
    "ci": "bun run lint && bun run typecheck && bun run test && bun run build",
    "start": "bun run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome ci .",
    "data:check": "bun scripts/validate-translations.ts",
    "data:check:inputs": "bun scripts/validate-translations.ts --inputs",
    "data:import": "bun scripts/import-translations.ts",
    "data:split": "bun scripts/split-translation.ts",
    "licenses:generate": "bun scripts/generate-third-party-notices.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-serif": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.8.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-error-boundary": "^6.1.1",
    "react-router-dom": "7.14.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.12",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.4"
  }
}
